Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
    - Class: rviz/TF
      Name: TF
      Enabled: false
    - Class: rviz/Odometry
      Name: Odometry
      Enabled: true
      Topic: /odom
      Keep: 200
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 255; 25; 0
        Shaft Length: 0.4
        Shaft Radius: 0.03
        Head Length: 0.1
        Head Radius: 0.08
    - Class: rviz/PointCloud2
      Name: LiDAR /points
      Enabled: true
      Topic: /points
      Size (m): 0.03
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Pitch: 0.6
      Yaw: 3.9
      Target Frame: base_footprint
Window Geometry:
  Height: 900
  Width: 1400
