<?xml version="1.0"?>
<!-- SD (single drive, pallet-truck type) robot-side bringup (see base.launch). Virtual model until the
     CAD arrives (wonik_cobot_description/config/sd/geometry.yaml). On the real robot, start it next to
     the drive unit driver and the IMU driver:
       roslaunch wonik_cobot_bringup sd.launch [ekf:=false] -->
<launch>
  <arg name="xacro_args" default=""/>
  <arg name="ekf" default="true"/>

  <include file="$(find wonik_cobot_bringup)/launch/base.launch" pass_all_args="true">
    <arg name="robot" value="sd"/>
  </include>
</launch>
