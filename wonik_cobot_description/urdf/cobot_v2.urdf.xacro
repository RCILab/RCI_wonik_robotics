<?xml version="1.0"?>
<!-- Wonik cobot_v2 (QD #2 type). Geometry comes from config/cobot_v2/geometry.yaml; the cobot arm is not modelled.
     Meshes are visual only (converted from cobot_v2_asm.stp); collisions are primitives.
     Everything Gazebo-specific is in cobot_v2.gazebo.xacro (ignored outside Gazebo).
       xacro cobot_v2.urdf.xacro [sim_drive:=kinematic|physics] [lidar_gpu:=true] [depth_camera:=false] -->
<robot name="wonik_cobot_v2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="geometry" default="$(find wonik_cobot_description)/config/cobot_v2/geometry.yaml"/>
  <xacro:arg name="sim_drive" default="kinematic"/>
  <xacro:arg name="lidar_gpu" default="false"/>
  <!-- Gazebo depth camera sensor; it needs an X display (rendering) to produce images -->
  <xacro:arg name="depth_camera" default="true"/>

  <xacro:include filename="$(find wonik_cobot_description)/urdf/cobot_v2.gazebo.xacro"/>

  <xacro:property name="g" value="${xacro.load_yaml('$(arg geometry)')}"/>
  <xacro:property name="wheel_r" value="${g['wheel_diameter'] / 2.0}"/>
  <xacro:property name="omni_r" value="${g['omni_diameter'] / 2.0}"/>
  <xacro:property name="mesh_dir" value="package://wonik_cobot_description/meshes/cobot_v2"/>

  <material name="body_grey"><color rgba="0.70 0.71 0.74 1.0"/></material>
  <material name="qd_red"><color rgba="0.75 0.22 0.18 1.0"/></material>

  <!-- base: base_link coincides with base_footprint (floor, body centre); mesh is in this frame -->
  <link name="base_footprint"/>
  <joint name="base_link_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <xacro:property name="b" value="${g['body_box']}"/>
  <xacro:property name="body_h" value="${b[3] - b[2]}"/>
  <link name="base_link">
    <inertial>
      <mass value="${g['body_mass']}"/>
      <origin xyz="0 0 ${b[2] + body_h / 2}"/>
      <inertia ixx="${g['body_mass'] * (b[1] ** 2 + body_h ** 2) / 12}" ixy="0" ixz="0"
               iyy="${g['body_mass'] * (b[0] ** 2 + body_h ** 2) / 12}" iyz="0"
               izz="${g['body_mass'] * (b[0] ** 2 + b[1] ** 2) / 12}"/>
    </inertial>
    <visual>
      <geometry><mesh filename="${mesh_dir}/base.stl"/></geometry>
      <material name="body_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${b[2] + body_h / 2}"/>
      <geometry><box size="${b[0]} ${b[1]} ${body_h}"/></geometry>
    </collision>
  </link>

  <!-- QD unit: steer (revolute within +-steer_limit_deg, position interface) + drive (continuous, velocity
       interface). Steer frame sits on the steer axis at wheel-centre height; x = rolling direction at angle 0. -->
  <xacro:property name="steer_limit" value="${g['steer_limit_deg'] * pi / 180.0}"/>
  <xacro:macro name="qd_unit" params="name x y">
    <joint name="${name}_steer_joint" type="revolute">
      <origin xyz="${x} ${y} ${wheel_r}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="1.0"/>
      <limit lower="${-steer_limit}" upper="${steer_limit}" effort="1000.0" velocity="${g['steer_max_vel']}"/>
      <parent link="base_link"/>
      <child link="${name}_steer_link"/>
    </joint>
    <link name="${name}_steer_link">
      <inertial>
        <mass value="2.0"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
      <visual>
        <geometry><mesh filename="${mesh_dir}/qd_unit.stl"/></geometry>
        <material name="qd_red"/>
      </visual>
    </link>

    <joint name="${name}_drive_joint" type="continuous">
      <origin xyz="0 0 0" rpy="${-pi / 2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.015"/>
      <limit effort="1000.0" velocity="20.0"/>
      <parent link="${name}_steer_link"/>
      <child link="${name}_drive_link"/>
    </joint>
    <xacro:property name="w" value="${g['wheel_width']}"/>
    <link name="${name}_drive_link">
      <inertial>
        <mass value="5.0"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="${5.0 * (3 * wheel_r ** 2 + w ** 2) / 12}" ixy="0" ixz="0"
                 iyy="${5.0 * (3 * wheel_r ** 2 + w ** 2) / 12}" iyz="0" izz="${5.0 * wheel_r ** 2 / 2}"/>
      </inertial>
      <!-- Sphere, not a cylinder: ODE puts a rigid cylinder's contact on its rim edge, so the wheel
           rolls on the outer edge while the body turns and wheel odometry over-reads yaw (+44 deg per
           in-place turn with a 6 cm cylinder, +1.7 deg with the sphere). -->
      <collision>
        <geometry><sphere radius="${wheel_r}"/></geometry>
      </collision>
    </link>


  </xacro:macro>

  <!-- Passive omni wheel: sphere contact (its visual is part of base.stl). -->
  <xacro:macro name="omni_wheel" params="name x y">
    <joint name="${name}_omni_joint" type="fixed">
      <origin xyz="${x} ${y} ${omni_r}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${name}_omni_link"/>
    </joint>
    <link name="${name}_omni_link">
      <inertial>
        <mass value="2.0"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
      </inertial>
      <collision>
        <geometry><sphere radius="${omni_r}"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- xacro has no loops -->
  <xacro:macro name="qd_units" params="i:=0">
    <xacro:if value="${i &lt; len(g['module_names'])}">
      <xacro:qd_unit name="${g['module_names'][i]}" x="${g['module_x'][i]}" y="${g['module_y'][i]}"/>
      <xacro:qd_units i="${i + 1}"/>
    </xacro:if>
  </xacro:macro>
  <xacro:macro name="omni_wheels" params="i:=0">
    <xacro:if value="${i &lt; len(g['omni_names'])}">
      <xacro:omni_wheel name="${g['omni_names'][i]}" x="${g['omni_x'][i]}" y="${g['omni_y'][i]}"/>
      <xacro:omni_wheels i="${i + 1}"/>
    </xacro:if>
  </xacro:macro>
  <xacro:qd_units/>
  <xacro:omni_wheels/>

  <!-- 3D LiDAR (velodyne_simulator), stand-in for the Mid-360. Topic /points, frame velodyne.
       min_range 0.3 m instead of the HDL-32E's 0.9 m, closer to the Mid-360 (0.1 m): obstacles right
       beside the body must be visible (turn-in-place check); 0.3 m keeps most deck hits out. -->
  <xacro:property name="l" value="${g['lidar_xyz']}"/>
  <link name="velodyne">
    <inertial><mass value="0.8"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><geometry><cylinder radius="0.04" length="0.07"/></geometry></visual>
  </link>
  <joint name="velodyne_joint" type="fixed">
    <parent link="base_link"/><child link="velodyne"/><origin xyz="${l[0]} ${l[1]} ${l[2]}" rpy="0 0 0"/>
  </joint>
  <gazebo reference="velodyne">
    <sensor name="lidar" type="${'gpu_ray' if '$(arg lidar_gpu)' == 'true' else 'ray'}">
      <always_on>true</always_on><update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal><samples>625</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal>
          <vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.5353</min_angle><max_angle>0.1862</max_angle></vertical>
        </scan>
        <range><min>0.3</min><max>30.0</max><resolution>0.01</resolution></range>
      </ray>
      <plugin name="lidar_ros" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=/points</remapping></ros>
        <output_type>sensor_msgs/PointCloud2</output_type><frame_name>velodyne</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Front depth camera (RealSense D435). camera_depth_optical_frame: z forward, x right, y down. -->
  <xacro:property name="c" value="${g['depth_camera_xyz']}"/>
  <joint name="camera_joint" type="fixed">
    <origin xyz="${c[0]} ${c[1]} ${c[2]}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>
  <link name="camera_link">
    <inertial>
      <mass value="0.07"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="-0.0125 0 0"/>
      <geometry><box size="0.025 0.09 0.025"/></geometry>
      <material name="body_grey"/>
    </visual>
  </link>
  <joint name="camera_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
  </joint>
  <link name="camera_depth_optical_frame"/>

  <!-- IMU: /imu/data in frame imu_link -->
  <xacro:property name="i" value="${g['imu_xyz']}"/>
  <xacro:property name="ir" value="${g['imu_rpy']}"/>
  <joint name="imu_joint" type="fixed">
    <origin xyz="${i[0]} ${i[1]} ${i[2]}" rpy="${ir[0]} ${ir[1]} ${ir[2]}"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <xacro:cobot_v2_gazebo sim_drive="$(arg sim_drive)" depth_camera="$(arg depth_camera)"/>

  <xacro:arg name="hardware_plugin" default="gazebo_ros2_control/GazeboSystem"/>
  <ros2_control name="WonikSystem" type="system">
    <hardware><plugin>$(arg hardware_plugin)</plugin></hardware>
    <xacro:macro name="control_modules" params="i:=0">
      <xacro:if value="${i &lt; len(g['module_names'])}">
        <joint name="${g['steer_joints'][i]}">
          <command_interface name="position">
            <param name="min">${-steer_limit}</param>
            <param name="max">${steer_limit}</param>
          </command_interface>
          <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${g['drive_joints'][i]}">
          <command_interface name="velocity"/>
          <state_interface name="position"/><state_interface name="velocity"/>
        </joint>
        <xacro:control_modules i="${i+1}"/>
      </xacro:if>
    </xacro:macro>
    <xacro:control_modules/>
  </ros2_control>

</robot>
