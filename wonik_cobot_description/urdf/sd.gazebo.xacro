<?xml version="1.0"?>
<!-- Gazebo-only part of the SD model; included by sd.urdf.xacro and ignored outside Gazebo.
     Uses the properties g (geometry.yaml) and wheel_r of the including file.
       sim_drive:=kinematic  wheel, roller and caster contacts are frictionless and the qd_kinematic_base
                             plugin (wonik_gazebo) moves the base with the twist that the measured steer
                             angle and wheel speed imply. No slip; for SLAM and navigation work.
       sim_drive:=physics    the drive wheel moves the base through contact friction and the fork rollers
                             (free to roll, not to slide) hold the axle. Not tuned: only for a first look. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="sd_gazebo" params="sim_drive depth_camera:=true">
    <xacro:property name="kinematic" value="${sim_drive == 'kinematic'}"/>
    <xacro:if value="${sim_drive not in ['kinematic', 'physics']}">
      <xacro:unknown_sim_drive_use_kinematic_or_physics/>
    </xacro:if>

    <gazebo reference="base_link">
      <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="chassis_link">
      <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="fork_link">
      <material>Gazebo/Grey</material>
    </gazebo>

    <xacro:property name="unit" value="${g['module_names'][0]}"/>
    <gazebo reference="${unit}_steer_link">
      <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="${unit}_drive_link">
      <material>Gazebo/Orange</material>
      <mu1>${0.0 if kinematic else 2.0}</mu1>
      <mu2>${0.0 if kinematic else 2.0}</mu2>
    </gazebo>

    <xacro:macro name="rollers_gazebo" params="i:=0">
      <xacro:if value="${i &lt; len(g['roller_names'])}">
        <gazebo reference="${g['roller_names'][i]}_link">
          <material>Gazebo/Green</material>
          <mu1>${0.0 if kinematic else 1.0}</mu1>
          <mu2>${0.0 if kinematic else 1.0}</mu2>
        </gazebo>
        <xacro:rollers_gazebo i="${i + 1}"/>
      </xacro:if>
    </xacro:macro>
    <xacro:rollers_gazebo/>

    <xacro:macro name="casters_gazebo" params="i:=0">
      <xacro:if value="${i &lt; len(g['caster_names'])}">
        <gazebo reference="${g['caster_names'][i]}_link">
          <mu1>${0.0 if kinematic else 0.01}</mu1>
          <mu2>${0.0 if kinematic else 0.01}</mu2>
        </gazebo>
        <xacro:casters_gazebo i="${i + 1}"/>
      </xacro:if>
    </xacro:macro>
    <xacro:casters_gazebo/>

    <!-- Front depth camera: /camera/depth/points (frame camera_depth_optical_frame), 15 Hz, D435 FOV -->
    <xacro:if value="${depth_camera}">
      <gazebo reference="camera_link">
        <sensor type="depth" name="depth_camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.5184</horizontal_fov>
            <image>
              <format>R8G8B8</format>
              <width>424</width>
              <height>240</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </camera>
          <plugin name="depth_camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/camera</namespace>
              <remapping>camera/points:=depth/points</remapping>
              <remapping>camera/image_raw:=rgb/image_raw</remapping>
              <remapping>camera/camera_info:=rgb/camera_info</remapping>
              <remapping>camera/depth/image_raw:=depth/image_raw</remapping>
              <remapping>camera/depth/camera_info:=depth/camera_info</remapping>
            </ros>
            <camera_name>camera</camera_name><frame_name>camera_depth_optical_frame</frame_name>
            <min_depth>0.1</min_depth><max_depth>6.0</max_depth>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:if>

    <!-- IMU: /imu/data (frame imu_link) at 200 Hz, as on cobot_v2 (typical MEMS gyro noise, no bias). -->
    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></z>
          </angular_velocity>
        </imu>
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros><remapping>~/out:=/imu/data</remapping></ros>
          <frame_name>imu_link</frame_name><initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo>
      <!-- Steer joint: position, drive joint: velocity (as on the real drive unit). -->
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <parameters>$(find wonik_cobot_bringup)/config/sd/controllers.yaml</parameters>
      </plugin>

      <!-- Ground truth of base_footprint for evaluation: /ground_truth/odom in frame world, no TF. -->
      <plugin name="ground_truth" filename="libgazebo_ros_p3d.so">
        <ros><remapping>odom:=/ground_truth/odom</remapping></ros>
        <update_rate>50.0</update_rate><body_name>base_footprint</body_name>
        <frame_name>world</frame_name><gaussian_noise>0.0</gaussian_noise>
      </plugin>

      <xacro:if value="${kinematic}">
        <plugin name="qd_kinematic_base" filename="libqd_kinematic_base.so">
          <driveType>${g['drive_type']}</driveType>
          <moduleX>${' '.join([str(v) for v in g['module_x']])}</moduleX>
          <moduleY>${' '.join([str(v) for v in g['module_y']])}</moduleY>
          <fixedAxleX>${g['fixed_axle_x']}</fixedAxleX>
          <wheelRadius>${wheel_r}</wheelRadius>
          <steerJoints>${' '.join(g['steer_joints'])}</steerJoints>
          <driveJoints>${' '.join(g['drive_joints'])}</driveJoints>
        </plugin>
      </xacro:if>
    </gazebo>
  </xacro:macro>

</robot>
