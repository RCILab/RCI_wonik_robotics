<?xml version="1.0"?>
<package format="2">
  <name>stop_go_local_planner</name>
  <version>0.1.0</version>
  <description>Stop-and-go route follower (nav_core local planner, usable in move_base and move_base_flex): straight segments, in-place rotations at corners, pure pursuit. Structured after neo_local_planner.</description>
  <maintainer email="wjddbsgur501@khu.ac.kr">yoonhyuck Jung</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>angles</depend>
  <depend>base_local_planner</depend>
  <depend>local_planner_checks</depend>
  <depend>costmap_2d</depend>
  <depend>nav_core</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <export>
    <nav_core plugin="${prefix}/blp_plugin.xml"/>
  </export>
</package>
