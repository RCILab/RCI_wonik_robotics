<?xml version="1.0"?>
<!-- 2D mapping: /points -> /scan -> slam_toolbox (online async). Publishes /map and TF map->odom.
       roslaunch wonik_navigation mapping.launch
       rosrun map_server map_saver -f <dir>/<name>        (save when the map is complete) -->
<launch>
  <arg name="robot" default="cobot_v2"/>
  <arg name="rviz" default="true"/>

  <include file="$(find wonik_navigation)/launch/scan.launch">
    <arg name="robot" value="$(arg robot)"/>
  </include>

  <node pkg="slam_toolbox" type="async_slam_toolbox_node" name="slam_toolbox" output="screen">
    <rosparam file="$(find wonik_navigation)/config/slam_toolbox_mapping.yaml" command="load"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz_mapping"
        args="-d $(find wonik_navigation)/rviz/navigation.rviz"/>
</launch>
