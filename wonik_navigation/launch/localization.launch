<?xml version="1.0"?>
<!-- Localization on a saved map: map_server + /scan + AMCL. Publishes TF map->odom.
       roslaunch wonik_navigation localization.launch [map:=wonik_hall] [x:= y:= yaw:=]
     The initial pose can also be set with RViz "2D Pose Estimate". -->
<launch>
  <arg name="robot" default="cobot_v2"/>
  <arg name="map" default="wonik_hall"/>
  <arg name="map_file" default="$(find wonik_navigation)/maps/$(arg map).yaml"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="yaw" default="0.0"/>
  <arg name="rviz" default="true"/>

  <node pkg="map_server" type="map_server" name="map_server" args="$(arg map_file)"/>

  <include file="$(find wonik_navigation)/launch/scan.launch">
    <arg name="robot" value="$(arg robot)"/>
  </include>

  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <rosparam file="$(find wonik_navigation)/config/$(arg robot)/amcl.yaml" command="load"/>
    <param name="initial_pose_x" value="$(arg x)"/>
    <param name="initial_pose_y" value="$(arg y)"/>
    <param name="initial_pose_a" value="$(arg yaw)"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz_localization"
        args="-d $(find wonik_navigation)/rviz/navigation.rviz"/>
</launch>
