<?xml version="1.0"?>
<!-- Localization (map_server + AMCL), move_base_flex with the route controllers, obstacle detection,
     zones and the cmd_vel gate.
       roslaunch wonik_navigation navigation.launch [map:=wonik_hall] [zones:=wonik_hall]
       roslaunch wonik_navigation route.launch [route:=wonik_hall_u]      (another terminal)
     move_base_flex -> cmd_vel_raw -> cmd_vel_gate -> cmd_vel: the gate stops the robot for obstacles
     except on a running detour, and always when a required sensor is silent.
     depth_camera:=false: the front depth camera is switched off on purpose (it is then neither required
     by the obstacle detector nor a costmap source); with true, a silent camera stops the robot. -->
<launch>
  <arg name="robot" default="cobot_v2"/>
  <arg name="map" default="wonik_hall"/>
  <arg name="zones" default="wonik_hall"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="yaw" default="0.0"/>
  <arg name="rviz" default="true"/>
  <arg name="depth_camera" default="true"/>

  <include file="$(find wonik_navigation)/launch/localization.launch">
    <arg name="robot" value="$(arg robot)"/>
    <arg name="map" value="$(arg map)"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="yaw" value="$(arg yaw)"/>
    <arg name="rviz" value="false"/>
  </include>

  <node pkg="mbf_costmap_nav" type="mbf_costmap_nav" name="move_base_flex" output="screen">
    <remap from="cmd_vel" to="cmd_vel_raw"/>
    <rosparam file="$(find wonik_navigation)/config/move_base_flex.yaml" command="load"/>
    <rosparam file="$(find wonik_navigation)/config/costmaps.yaml" command="load"/>
    <rosparam ns="global_costmap" file="$(find wonik_navigation)/config/$(arg robot)/footprint.yaml" command="load"/>
    <rosparam ns="local_costmap" file="$(find wonik_navigation)/config/$(arg robot)/footprint.yaml" command="load"/>
    <rosparam file="$(find wonik_navigation)/config/$(arg robot)/stop_go.yaml" command="load"/>
    <rosparam file="$(find wonik_navigation)/config/$(arg robot)/avoid.yaml" command="load"/>
    <param unless="$(arg depth_camera)" name="global_costmap/obstacle_layer/observation_sources" value="scan"/>
    <param unless="$(arg depth_camera)" name="local_costmap/obstacle_layer/observation_sources" value="scan"/>
  </node>

  <node pkg="wonik_navigation" type="obstacle_detector.py" name="obstacle_detector" output="screen">
    <rosparam file="$(find wonik_navigation)/config/$(arg robot)/obstacle_detector.yaml" command="load"/>
    <rosparam file="$(find wonik_navigation)/config/$(arg robot)/footprint.yaml" command="load"/>
    <rosparam unless="$(arg depth_camera)" param="required_topics">[/points_self_filtered]</rosparam>
  </node>

  <node pkg="wonik_navigation" type="zone_manager.py" name="zone_manager" output="screen">
    <param name="zones" value="$(find wonik_navigation)/config/zones/$(arg zones).yaml"/>
  </node>

  <node pkg="wonik_navigation" type="cmd_vel_gate.py" name="cmd_vel_gate" output="screen"/>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz_navigation"
        args="-d $(find wonik_navigation)/rviz/navigation.rviz"/>
</launch>
