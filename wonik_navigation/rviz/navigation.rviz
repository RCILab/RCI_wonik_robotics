Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
      Alpha: 0.7
      Color Scheme: map
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
    - Class: rviz/LaserScan
      Name: Scan
      Enabled: true
      Topic: /scan
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Decay Time: 0
    - Class: rviz/Path
      Name: Route
      Enabled: true
      Topic: /route_supervisor/route_path
      Color: 0; 120; 255
      Line Style: Billboards
      Line Width: 0.04
    - Class: rviz/Path
      Name: Remaining route (stop_go)
      Enabled: true
      Topic: /move_base_flex/stop_go/local_plan
      Color: 255; 170; 0
      Line Style: Billboards
      Line Width: 0.03
    - Class: rviz/Path
      Name: Detour (avoid)
      Enabled: true
      Topic: /move_base_flex/avoid/local_plan
      Color: 0; 200; 80
      Line Style: Billboards
      Line Width: 0.03
    - Class: rviz/MarkerArray
      Name: Zones
      Enabled: true
      Marker Topic: /zone_manager/markers
    - Class: rviz/Marker
      Name: Obstacle detection box
      Enabled: true
      Marker Topic: /obstacle_detector/box_marker
    - Class: rviz/PointCloud2
      Name: Depth camera
      Enabled: false
      Topic: /camera/depth/points
      Size (m): 0.02
      Style: Points
      Color Transformer: FlatColor
      Color: 0; 200; 255
    - Class: rviz/Map
      Name: Global costmap
      Enabled: false
      Topic: /move_base_flex/global_costmap/costmap
      Color Scheme: costmap
    - Class: rviz/Map
      Name: Local costmap
      Enabled: false
      Topic: /move_base_flex/local_costmap/costmap
      Color Scheme: costmap
    - Class: rviz/Odometry
      Name: Odometry
      Enabled: false
      Topic: /odom
      Keep: 100
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Scale: 40
      X: 6
      Y: 3
      Target Frame: map
Window Geometry:
  Height: 900
  Width: 1400
