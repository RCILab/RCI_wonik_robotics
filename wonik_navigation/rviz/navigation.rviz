Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 30
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Alpha: 0.7
    Color Scheme: map
    Topic:
      Value: /map
      Depth: 5
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/LaserScan
    Name: Scan
    Enabled: true
    Size (m): 0.05
    Style: Flat Squares
    Color Transformer: FlatColor
    Color: 255; 0; 0
    Decay Time: 0
    Topic:
      Value: /scan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/Path
    Name: Route
    Enabled: true
    Color: 0; 120; 255
    Line Style: Billboards
    Line Width: 0.04
    Topic:
      Value: /route_supervisor/route_path
      Depth: 5
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Path
    Name: Remaining route (stop_go)
    Enabled: true
    Color: 255; 170; 0
    Line Style: Billboards
    Line Width: 0.03
    Topic:
      Value: /stop_go/local_plan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/Path
    Name: Detour (avoid)
    Enabled: true
    Color: 0; 200; 80
    Line Style: Billboards
    Line Width: 0.03
    Topic:
      Value: /avoid/local_plan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/MarkerArray
    Name: Zones
    Enabled: true
    Topic:
      Value: /zone_manager/markers
      Depth: 5
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Marker
    Name: Obstacle detection box
    Enabled: true
    Topic:
      Value: /obstacle_detector/box_marker
      Depth: 5
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/PointCloud2
    Name: Depth camera
    Enabled: false
    Size (m): 0.02
    Style: Points
    Color Transformer: FlatColor
    Color: 0; 200; 255
    Topic:
      Value: /camera/depth/points
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/Map
    Name: Global costmap
    Enabled: false
    Color Scheme: costmap
    Topic:
      Value: /global_costmap/costmap
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/Map
    Name: Local costmap
    Enabled: false
    Color Scheme: costmap
    Topic:
      Value: /local_costmap/costmap
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/Odometry
    Name: Odometry
    Enabled: false
    Keep: 100
    Topic:
      Value: /odom
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetInitialPose
    Topic: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 40
      X: 6
      Y: 3
      Target Frame: map
Window Geometry:
  Height: 900
  Width: 1400
